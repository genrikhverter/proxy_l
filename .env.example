# Пример конфигурации. Скопируйте в .env и подставьте свои значения.
# Запуск с этим файлом:  set -a; . ./.env; set +a; cargo run --release

# --- Обязательно -----------------------------------------------------------

# Настоящий ключ провайдера. Знает только сервер, клиентам не выдаётся.
UPSTREAM_API_KEY=sk-ЗАМЕНИТЕ_НА_КЛЮЧ_ПРОВАЙДЕРА

# Ключи для ВАШИХ клиентов, через запятую (по одному на сервис/команду).
# Минимум 16 символов. Генерировать так:  openssl rand -hex 32
PROXY_API_KEYS=8f1c...первый_ключ,2b7d...второй_ключ

# --- Необязательно (значения по умолчанию показаны) ------------------------

# Куда слушать. 127.0.0.1 — только локально; 0.0.0.0 — принимать извне (в Docker).
PROXY_LISTEN=127.0.0.1:8080

# Любой OpenAI-совместимый API: OpenAI, OpenRouter, Together, vLLM, Ollama и т.д.
UPSTREAM_BASE_URL=https://api.openai.com/v1

# Список разрешённых моделей. Пусто = любые (лучше задать явно).
ALLOWED_MODELS=gpt-4o-mini,gpt-4o

# Потолок длины ответа: большие max_tokens от клиента урезаются до этого числа.
MAX_OUTPUT_TOKENS=4096

# Запросов в минуту на одного клиента (всплеск до этого же числа).
RATE_LIMIT_PER_MIN=60

# Одновременных обращений к провайдеру; лишние получают 503.
MAX_CONCURRENT=32

# Полный таймаут обычного (не стримингового) запроса, секунды.
REQUEST_TIMEOUT_SECS=120

# Максимальная пауза между кусками ответа, секунды (действует и внутри стрима).
# Для «думающих» моделей (o-серия, reasoning) ставьте 180-300.
UPSTREAM_IDLE_TIMEOUT_SECS=120

# Уровень логов: error | warn | info | debug
RUST_LOG=info
